'use client';
import { useState, useEffect } from 'react';
import { useQuery, useMutation } from '@apollo/client';
import { GET_ORGANIZATIONS, GET_WORKFLOWS } from '../graphql/queries';
import { 
  CREATE_WORKFLOW, UPDATE_WORKFLOW, DELETE_WORKFLOW, 
  INSERT_WORKFLOW_STEP, UPDATE_WORKFLOW_STEP, DELETE_WORKFLOW_STEP, 
  INSERT_WORKFLOW_TRIGGER, UPDATE_WORKFLOW_TRIGGER, DELETE_WORKFLOW_TRIGGER 
} from '../graphql/mutations';
import { useUserData } from '@nhost/nextjs';

import { gql } from '@apollo/client';

const TRIGGER_WORKFLOW_RUN = gql`
  mutation TriggerWorkflowRun($workflowId: uuid!) {
    triggerWorkflowRun(workflow_id: $workflowId) {
      workflow_run_id
      status
      message
    }
  }
`;

export function WorkflowApp() {
  const user = useUserData();
  const [selectedOrgId, setSelectedOrgId] = useState<string | null>(null);
  const [selectedWorkflowId, setSelectedWorkflowId] = useState<string | null>(null);

  const { data: orgData, loading: orgLoading, error: orgError } = useQuery(GET_ORGANIZATIONS, {
    onCompleted: (data) => {
      if (data?.organizations?.length > 0 && !selectedOrgId) {
        setSelectedOrgId(data.organizations[0].id);
      }
    }
  });

  const { data: wfData, loading: wfLoading, error: wfError, refetch: refetchWf } = useQuery(GET_WORKFLOWS, {
    variables: { orgId: selectedOrgId },
    skip: !selectedOrgId,
  });

  const [createWorkflow] = useMutation(CREATE_WORKFLOW, {
    onCompleted: () => refetchWf()
  });

  if (orgLoading) return <div className="p-8 text-white">Loading organizations...</div>;
  if (orgError) return <div className="p-8 text-red-500">Error loading orgs: {orgError.message}</div>;

  const orgs = orgData?.organizations || [];

  if (orgs.length === 0) {
    return <div className="p-8 text-white">You don&apos;t belong to any organizations.</div>;
  }

  const handleCreateWorkflow = async () => {
    const name = prompt("Workflow Name:");
    if (name && selectedOrgId) {
      try {
        await createWorkflow({ variables: { orgId: selectedOrgId, name, description: '' } });
      } catch(err: any) { alert(err.message); }
    }
  };

  const selectedWorkflow = wfData?.workflows?.find((w: any) => w.id === selectedWorkflowId);
  const selectedOrg = orgs.find((o: any) => o.id === selectedOrgId);
  
  // Get role: fallback to viewer if not found
  let userRole = 'viewer';
  if (selectedOrg && user?.id) {
    const member = selectedOrg.org_members.find((m: any) => m.user_id === user.id);
    if (member) {
      userRole = member.role;
    }
  }

  const isOwner = userRole === 'owner';
  const isEditor = userRole === 'editor' || isOwner;
  const canEditWorkflow = isOwner || isEditor;

  return (
    <div className="flex h-screen bg-[#050507] text-slate-300">
      <aside className="w-64 border-r border-slate-800 bg-[#0a0a0c] flex flex-col">
        <div className="p-4 border-b border-slate-800">
          <select 
            className="w-full bg-slate-900 border border-slate-700 text-white rounded p-2 text-sm"
            value={selectedOrgId || ''}
            onChange={e => {
              setSelectedOrgId(e.target.value);
              setSelectedWorkflowId(null);
            }}
          >
            {orgs.map((org: any) => (
              <option key={org.id} value={org.id}>{org.name}</option>
            ))}
          </select>
          <div className="mt-2 text-xs text-slate-500">
            Role: <span className="font-bold uppercase text-indigo-400">{userRole}</span>
          </div>
        </div>
        <div className="p-4 flex-1 overflow-auto">
          <div className="flex justify-between items-center mb-4">
            <h2 className="text-xs font-bold uppercase tracking-widest text-slate-500">Workflows</h2>
            {canEditWorkflow && (
              <button onClick={handleCreateWorkflow} className="text-indigo-400 text-xl">+</button>
            )}
          </div>
          {wfLoading && <div className="text-sm">Loading workflows...</div>}
          {wfError && <div className="text-sm text-red-500">{wfError.message}</div>}
          <div className="flex flex-col gap-2">
            {wfData?.workflows?.map((wf: any) => (
              <button
                key={wf.id}
                onClick={() => setSelectedWorkflowId(wf.id)}
                className={`text-left px-3 py-2 rounded text-sm ${selectedWorkflowId === wf.id ? 'bg-indigo-600 text-white' : 'hover:bg-slate-800'}`}
              >
                {wf.name}
              </button>
            ))}
          </div>
        </div>
      </aside>
      <main className="flex-1 flex flex-col overflow-hidden">
        {selectedWorkflow ? (
          <WorkflowBuilder 
            workflow={selectedWorkflow} 
            refetch={refetchWf} 
            userRole={userRole}
          />
        ) : (
          <div className="flex-1 flex items-center justify-center">
            <p className="text-slate-500">Select or create a workflow to get started.</p>
          </div>
        )}
      </main>
    </div>
  );
}

function WorkflowBuilder({ workflow, refetch, userRole }: { workflow: any, refetch: () => void, userRole: string }) {
  const [updateWorkflow] = useMutation(UPDATE_WORKFLOW);
  const [deleteWorkflow] = useMutation(DELETE_WORKFLOW, { onCompleted: () => refetch() });
  
  const [insertStep] = useMutation(INSERT_WORKFLOW_STEP, { onCompleted: () => refetch() });
  const [updateStep] = useMutation(UPDATE_WORKFLOW_STEP);
  const [deleteStep] = useMutation(DELETE_WORKFLOW_STEP);
  
  const [insertTrigger] = useMutation(INSERT_WORKFLOW_TRIGGER, { onCompleted: () => refetch() });
  const [updateTrigger] = useMutation(UPDATE_WORKFLOW_TRIGGER);
  const [deleteTrigger] = useMutation(DELETE_WORKFLOW_TRIGGER, { onCompleted: () => refetch() });

  const isOwner = userRole === 'owner';
  const isEditor = userRole === 'editor' || isOwner;
  const canEditWorkflow = isOwner || isEditor;

  const handleUpdateName = async () => {
    const name = prompt("New workflow name:", workflow.name);
    if (name) {
      try {
        await updateWorkflow({ variables: { id: workflow.id, name, description: workflow.description } });
        refetch();
      } catch(err: any) { alert(err.message); }
    }
  };

  const handleUpdateDescription = async () => {
    const description = prompt("New description:", workflow.description || '');
    if (description !== null) {
      try {
        await updateWorkflow({ variables: { id: workflow.id, name: workflow.name, description } });
        refetch();
      } catch(err: any) { alert(err.message); }
    }
  };

  const handleDeleteWorkflow = async () => {
    if (confirm("Delete this workflow?")) {
      deleteWorkflow({ variables: { id: workflow.id } }).catch((err: any) => alert(err.message));
    }
  };

  const handleAddStep = async (type: string) => {
    const position = workflow.workflow_steps.length;
    try { 
      await insertStep({ variables: { workflowId: workflow.id, type, position, config: {} } }); 
    } catch(err: any) { alert(err.message); }
  };
  
  const handleMoveUp = async (index: number) => {
    if (index === 0) return;
    const currentStep = workflow.workflow_steps[index];
    const prevStep = workflow.workflow_steps[index - 1];
    try {
      await updateStep({ variables: { id: currentStep.id, position: 9999 } });
      await updateStep({ variables: { id: prevStep.id, position: currentStep.position } });
      await updateStep({ variables: { id: currentStep.id, position: prevStep.position } });
      refetch();
    } catch(err: any) { alert(err.message); }
  };

  const handleMoveDown = async (index: number) => {
    if (index === workflow.workflow_steps.length - 1) return;
    const currentStep = workflow.workflow_steps[index];
    const nextStep = workflow.workflow_steps[index + 1];
    try {
      await updateStep({ variables: { id: currentStep.id, position: 9999 } });
      await updateStep({ variables: { id: nextStep.id, position: currentStep.position } });
      await updateStep({ variables: { id: currentStep.id, position: nextStep.position } });
      refetch();
    } catch(err: any) { alert(err.message); }
  };

  const handleDeleteStep = async (id: string, index: number) => {
    if (confirm("Delete this step?")) {
      try {
        await deleteStep({ variables: { id } });
        const subsequent = workflow.workflow_steps.slice(index + 1);
        for (const step of subsequent) {
          await updateStep({ variables: { id: step.id, position: step.position - 1 } });
        }
        refetch();
      } catch(err: any) { alert(err.message); }
    }
  };

  const handleAddTrigger = async (type: string) => {
    try { 
      await insertTrigger({ variables: { workflowId: workflow.id, type, config: {} } }); 
    } catch(err: any) { alert(err.message); }
  };
  
  const handleUpdateTriggerConfig = async (id: string, config: any) => {
    try { 
      await updateTrigger({ variables: { id, config } }); 
    } catch(err: any) { alert(err.message); }
  };

  const handleDeleteTrigger = async (id: string) => {
    if (confirm("Delete this trigger?")) {
      try { 
        await deleteTrigger({ variables: { id } }); 
      } catch(err: any) { alert(err.message); }
    }
  };
  
  const [triggerRun, { loading: runLoading }] = useMutation(TRIGGER_WORKFLOW_RUN);
  const [runResult, setRunResult] = useState<any>(null);

  const runManually = async () => {
    setRunResult(null);
    try {
      const res = await triggerRun({ variables: { workflowId: workflow.id } });
      const result = res.data?.triggerWorkflowRun;
      setRunResult({ type: 'success', data: result });
      refetch();
    } catch(err: any) {
      setRunResult({ type: 'error', message: err.message });
    }
  };

  return (
    <div className="flex-1 overflow-auto flex flex-col relative">
      <header className="p-6 border-b border-slate-800 flex justify-between items-center">
        <div>
          <h1 className="text-xl font-bold text-white flex items-center gap-2">
            {workflow.name}
            {canEditWorkflow && <button onClick={handleUpdateName} className="text-xs text-slate-500 hover:text-white">Edit Name</button>}
          </h1>
          <p className="text-sm text-slate-500 flex items-center gap-2">
            {workflow.description || 'No description'}
            {canEditWorkflow && <button onClick={handleUpdateDescription} className="text-xs text-slate-600 hover:text-white">Edit</button>}
          </p>
        </div>
        <div className="flex gap-4">
          {canEditWorkflow && (
             <button onClick={handleDeleteWorkflow} className="text-red-500 text-sm font-medium hover:text-red-400">Delete Workflow</button>
          )}
          {canEditWorkflow && (
             <button onClick={runManually} disabled={runLoading} className="px-4 py-2 bg-indigo-600 text-white rounded text-sm font-bold shadow-lg shadow-indigo-500/20 hover:bg-indigo-500 disabled:opacity-50">
               {runLoading ? 'Starting...' : 'Run Manually'}
             </button>
          )}
        </div>
      </header>
      
      {runResult && (
        <div className={`m-6 p-4 rounded text-sm ${runResult.type === 'error' ? 'bg-red-900/50 text-red-300 border border-red-800' : 'bg-emerald-900/50 text-emerald-300 border border-emerald-800'}`}>
          {runResult.type === 'error' ? (
            <p><strong>Error:</strong> {runResult.message}</p>
          ) : (
            <div>
              <p><strong>Run Started!</strong></p>
              <p>Run ID: {runResult.data.workflow_run_id}</p>
              <p>Status: {runResult.data.status}</p>
              <p>Message: {runResult.data.message}</p>
            </div>
          )}
        </div>
      )}

      <div className="flex-1 p-8 max-w-4xl w-full mx-auto flex flex-col gap-8 relative">
        <div className="absolute left-1/2 top-0 bottom-0 w-px bg-slate-800 -z-10"></div>
        
        {/* Triggers Section */}
        <section className="bg-slate-900/50 p-6 rounded-xl border border-slate-800">
          <h2 className="text-sm font-bold text-white mb-4">Triggers</h2>
          <div className="flex flex-col gap-4">
            {workflow.workflow_triggers?.map((t: any) => (
              <div key={t.id} className="p-4 bg-slate-900 border border-slate-700 rounded relative">
                {canEditWorkflow && (
                  <button onClick={() => handleDeleteTrigger(t.id)} className="absolute top-2 right-2 text-red-500 text-xs">Delete</button>
                )}
                <div className="text-sm font-bold text-emerald-400 mb-2">{t.type}</div>
                <textarea 
                  className="w-full bg-slate-800 text-xs p-2 rounded text-slate-300 font-mono h-20"
                  defaultValue={JSON.stringify(t.config, null, 2)}
                  disabled={!canEditWorkflow}
                  onBlur={e => {
                    try {
                      handleUpdateTriggerConfig(t.id, JSON.parse(e.target.value));
                    } catch (err) {
                      alert("Invalid JSON");
                    }
                  }}
                />
              </div>
            ))}
            {canEditWorkflow && (
              <div className="flex gap-2">
                 {isOwner && <button onClick={() => handleAddTrigger('webhook')} className="text-xs px-2 py-1 bg-slate-800 text-slate-300 hover:bg-slate-700 rounded">+ Webhook</button>}
                 <button onClick={() => handleAddTrigger('manual')} className="text-xs px-2 py-1 bg-slate-800 text-slate-300 hover:bg-slate-700 rounded">+ Manual</button>
                 <button onClick={() => handleAddTrigger('scheduled')} className="text-xs px-2 py-1 bg-slate-800 text-slate-300 hover:bg-slate-700 rounded">+ Scheduled</button>
                 <button onClick={() => handleAddTrigger('database_event')} className="text-xs px-2 py-1 bg-slate-800 text-slate-300 hover:bg-slate-700 rounded">+ DB Event</button>
              </div>
            )}
          </div>
        </section>

        {/* Steps Section */}
        <section className="bg-slate-900/50 p-6 rounded-xl border border-slate-800">
          <h2 className="text-sm font-bold text-white mb-4">Steps</h2>
          <div className="flex flex-col gap-4">
            {workflow.workflow_steps?.map((step: any, index: number) => (
              <div key={step.id} className="p-4 bg-slate-900 border border-slate-700 rounded relative shadow-lg">
                {canEditWorkflow && (
                  <div className="absolute top-2 right-2 flex items-center gap-2">
                    <button 
                      onClick={() => handleMoveUp(index)} 
                      disabled={index === 0} 
                      className="text-slate-400 hover:text-white disabled:opacity-30 disabled:cursor-not-allowed"
                    >
                      ↑
                    </button>
                    <button 
                      onClick={() => handleMoveDown(index)} 
                      disabled={index === workflow.workflow_steps.length - 1} 
                      className="text-slate-400 hover:text-white disabled:opacity-30 disabled:cursor-not-allowed"
                    >
                      ↓
                    </button>
                    <button onClick={() => handleDeleteStep(step.id, index)} className="text-red-500 text-xs ml-2 hover:text-red-400">Delete</button>
                  </div>
                )}
                <div className="text-xs text-slate-500 mb-1">Position {step.position}</div>
                <div className="text-sm font-bold text-indigo-400 mb-2">{step.type}</div>
                <textarea 
                  className="w-full bg-slate-800 text-xs p-2 rounded text-slate-300 font-mono h-24"
                  defaultValue={JSON.stringify(step.config, null, 2)}
                  disabled={!canEditWorkflow}
                  onBlur={async e => {
                    try {
                      await updateStep({ variables: { id: step.id, position: step.position, config: JSON.parse(e.target.value) } });
                    } catch (err) {
                      alert("Invalid JSON");
                    }
                  }}
                />
              </div>
            ))}
            {canEditWorkflow && (
              <div className="flex flex-wrap gap-2 mt-2">
                 <button onClick={() => handleAddStep('llm_call')} className="text-xs px-2 py-1 bg-slate-800 text-slate-300 hover:bg-slate-700 rounded">+ LLM Call</button>
                 <button onClick={() => handleAddStep('http_request')} className="text-xs px-2 py-1 bg-slate-800 text-slate-300 hover:bg-slate-700 rounded">+ HTTP Req</button>
                 <button onClick={() => handleAddStep('conditional_branch')} className="text-xs px-2 py-1 bg-slate-800 text-slate-300 hover:bg-slate-700 rounded">+ Condition</button>
                 <button onClick={() => handleAddStep('approval_gate')} className="text-xs px-2 py-1 bg-slate-800 text-slate-300 hover:bg-slate-700 rounded">+ Approval</button>
                 {isOwner && <button onClick={() => handleAddStep('db_write')} className="text-xs px-2 py-1 bg-slate-800 text-red-300 hover:bg-slate-700 rounded border border-red-900/50">+ DB Write (Owner)</button>}
                 {isOwner && <button onClick={() => handleAddStep('notify')} className="text-xs px-2 py-1 bg-slate-800 text-red-300 hover:bg-slate-700 rounded border border-red-900/50">+ Notify (Owner)</button>}
              </div>
            )}
          </div>
        </section>
      </div>
    </div>
  );
}
